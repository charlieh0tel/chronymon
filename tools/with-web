#!/bin/bash
# Run COMMAND in crates/chronymon-web/tests/browser against chronymon-web
# of this tree: build the server and the synthetic data, serve a
# synthetic database and a path with none, then run it.  With Node and
# `make web-deps`, natively; without, in Playwright's container, with
# the repository at the same path.
#
# Usage: tools/with-web COMMAND [ARGS...]
#   tools/with-web npx playwright test
#   tools/with-web node screenshots.mjs
set -euo pipefail

# The image's Playwright must match package.json's.
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.63.0-noble
# Hours of synthetic readings, longer than the 24 h windows tested.
HOURS=48

repo=$(cd "$(dirname "$0")/.." && pwd)
tests="$repo/crates/chronymon-web/tests/browser"
work="$repo/target/web-test"
cargo=${CARGO:-cargo}

cd "$repo"
# Ports the kernel has free, so runs in several worktrees at once do
# not serve each other's databases.
free_port() {
    python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}
FULL_PORT=$(free_port)
MISSING_PORT=$(free_port)
export CHRONYMON_WEB_FULL="http://127.0.0.1:$FULL_PORT"
export CHRONYMON_WEB_MISSING="http://127.0.0.1:$MISSING_PORT"
"$cargo" build -q -p chronymon-web --bins --examples
mkdir -p "$work"
rm -f "$work"/full.sqlite*
target/debug/examples/synthetic "$work/full.sqlite" "$HOURS"

pids=()
cleanup() {
    ((${#pids[@]})) && kill "${pids[@]}" 2>/dev/null
    wait 2>/dev/null || true
}
trap cleanup EXIT
serve() {
    target/debug/chronymon-web --listen "127.0.0.1:$1" --database "$2" 2>"$work/server-$1.log" &
    pids+=($!)
    for _ in $(seq 50); do
        curl -fs "http://127.0.0.1:$1/api/about" >/dev/null && return 0
        sleep 0.1
    done
    echo "chronymon-web on port $1 did not start: $(cat "$work/server-$1.log")" >&2
    return 1
}
serve "$FULL_PORT" "$work/full.sqlite"
serve "$MISSING_PORT" "$work/missing.sqlite"

# Natively only with `make web-deps`'s Chromium: a container run leaves
# node_modules without it.
if command -v npx >/dev/null && compgen -G "$tests/node_modules/playwright-core/.local-browsers/chromium-*" >/dev/null; then
    (cd "$tests" && PLAYWRIGHT_BROWSERS_PATH=0 "$@")
else
    # The host's network, to reach the servers; the caller's uid, so
    # node_modules and what is written are the caller's.
    docker run --rm --network host --user "$(id -u):$(id -g)" -e HOME=/tmp \
        -e CHRONYMON_WEB_FULL -e CHRONYMON_WEB_MISSING \
        -v "$repo:$repo" -w "$tests" "$PLAYWRIGHT_IMAGE" \
        sh -c 'npm ci --no-fund --no-audit --loglevel=error && exec "$@"' sh "$@"
fi
