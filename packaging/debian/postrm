#!/bin/sh
# Leaves the database alone on remove; purge takes it.  The chronymon
# user and group stay, as current Debian tooling leaves system users.
set -e

case "$1" in
purge)
    rm -rf /var/lib/chronymon
    rm -f /etc/systemd/system/chronymond.service.d/clock-group.conf
    rmdir --ignore-fail-on-non-empty /etc/systemd/system/chronymond.service.d 2>/dev/null || true
    ;;
esac

#DEBHELPER#

exit 0
