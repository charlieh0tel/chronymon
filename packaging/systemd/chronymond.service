[Unit]
Description=Record chronyd's tracking and source statistics
Documentation=https://github.com/charlieh0tel/chronymon
# After chronyd, not requiring it: chronyd stopping is something this
# records, not a reason to stop.
After=chrony.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
EnvironmentFile=-/etc/default/chronymond
ExecStart=/usr/bin/chronymond
# clap exits 2 for a usage error, which no restart fixes.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2

# chronyd's user, the only one besides root its socket admits
# (/run/chrony 0700 on Debian, chronyd.sock 0755).  Group chronymon,
# so the database is _chrony:chronymon and the web view, as chronymon,
# can read it, and only read it: a reader able to write would leave
# WAL files the daemon could not open.  _chrony as well, for chronyd's
# log directory.
User=_chrony
Group=chronymon
SupplementaryGroups=_chrony
UMask=0027
StateDirectory=chronymon
StateDirectoryMode=2750

ProtectSystem=strict
# Where the client binds its socket for chronyd's replies.  "-": absent
# until chrony starts, which must not stop this starting.  Made later
# and read-only here, chronymond exits for a restart (docs/how-it-works.md).
ReadWritePaths=-/run/chrony
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_INET and AF_INET6 for chronyd's UDP command port, when
# CHRONYMOND_SOCKET names it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
# Started by chrony starting, too: if this has stopped (its start limit
# reached, say, while chrony was broken), chrony coming back brings it
# back.  Not PartOf= or BindsTo=, which would stop it with chronyd,
# whose stopping it records.
WantedBy=multi-user.target chrony.service
