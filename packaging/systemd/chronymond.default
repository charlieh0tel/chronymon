# Settings for chronymond.  See `chronymond --help`.  Every line is
# commented out and shows the built-in default; uncomment one only to
# change it.

# chronyd's control socket, or its UDP command port, an address with
# or without a port (127.0.0.1, [::1]:323), which needs chronyd 4.7 and
# its opencommands (docs/how-it-works.md, "Over UDP").
#CHRONYMOND_SOCKET=/run/chrony/chronyd.sock

# The database.  The web view reads the same file.
#CHRONYMOND_DATABASE=/var/lib/chronymon/chronymon.sqlite

# Seconds between polls of chronyd.
#CHRONYMOND_INTERVAL=1

# chronyd's configuration, read for its makestep, which decides when a
# correction is recorded as a step rather than a large offset, and its
# refclocks' locks, which pair an NMEA with its PPS.  Read again
# whenever chronyd restarts; one that cannot be read leaves what was
# read last.  `none` for a chronyd given its directives on its command
# line, or reached over UDP on another host.
#CHRONYMOND_CHRONY_CONFIG=/etc/chrony/chrony.conf

# chronyd's log directory, and seconds between reads of it.  chronyd
# writes logs only as its `log` directive asks.
#CHRONYMOND_CHRONY_LOGS=/var/log/chrony
#CHRONYMOND_LOG_INTERVAL=10

# PPS devices to watch for missed edges, comma-separated: /dev/ppsN,
# or /dev/ptpN[:channel], a clock timestamping the pulse on a pin
# (chrony's `refclock PHC /dev/ptpN:extpps`), channel 0 by default.  A
# clock needs Linux 6.7 or later, and its device must be readable by
# _chrony's group, or clock's where it exists.  None by default.
#CHRONYMOND_PPS=/dev/ptp2

# chronyd's PID file, which tells a restart from a crash.
#CHRONYMOND_PID_FILE=/run/chrony/chronyd.pid
